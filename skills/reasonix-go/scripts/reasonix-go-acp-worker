#!/usr/bin/env python3
"""Small ACP host that lets Codex steer a running Reasonix implementation."""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import signal
import subprocess
import sys
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, TextIO

CAPACITY_PATTERN = re.compile(
    r"usage limit|rate limit|quota|insufficient (?:balance|credit)|"
    r"subscription.*limit|too many requests",
    re.IGNORECASE,
)
PROVIDER_STREAM_PATTERN = re.compile(
    r"stream ended before completion|unexpected EOF|connection reset by peer",
    re.IGNORECASE,
)
MAX_EVENT_TEXT = 1_200


class AcpError(RuntimeError):
    """Raised when the ACP peer returns an error or becomes unavailable."""


@dataclass(slots=True)
class PendingRequest:
    response: queue.Queue[dict[str, Any]]


class AcpBridge:
    def __init__(
        self,
        *,
        binary: str,
        cwd: Path,
        model: str,
        effort: str,
        heartbeat_seconds: int,
    ) -> None:
        self.cwd = cwd
        self.model = model
        self.effort = effort
        self.heartbeat_seconds = heartbeat_seconds
        self.process = subprocess.Popen(
            [
                binary,
                "acp",
                "--model",
                model,
                "--profile",
                "balanced",
                "--sandbox-bash",
                "enforce",
                "--workspace-only",
            ],
            cwd=cwd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        if self.process.stdin is None or self.process.stdout is None or self.process.stderr is None:
            raise AcpError("Reasonix ACP did not expose all required pipes")
        self._peer_stdin: TextIO = self.process.stdin
        self._peer_stdout: TextIO = self.process.stdout
        self._peer_stderr: TextIO = self.process.stderr
        self._write_lock = threading.Lock()
        self._output_lock = threading.Lock()
        self._pending_lock = threading.Lock()
        self._pending: dict[int, PendingRequest] = {}
        self._permission_lock = threading.Lock()
        self._permission_requests: dict[int, dict[str, Any]] = {}
        self._next_id = 1
        self._closed = threading.Event()
        self._shutdown = threading.Event()
        self._cancelled = threading.Event()
        self._prompt_active = threading.Event()
        self._followups: queue.Queue[str] = queue.Queue()
        self._turn_number = 0
        self._started_at = time.monotonic()
        self._last_activity_at = self._started_at
        self._message_parts: list[str] = []
        self._diagnostics: list[str] = []
        self._latest_status: dict[str, Any] = {}
        self._turn_error_reason: str | None = None
        self.session_id: str | None = None
        self.steer_method: str | None = None
        self._stdout_thread = threading.Thread(target=self._read_stdout, daemon=True)
        self._stderr_thread = threading.Thread(target=self._read_stderr, daemon=True)
        self._heartbeat_thread = threading.Thread(target=self._heartbeat, daemon=True)
        self._stdin_thread = threading.Thread(target=self._read_orchestrator_input, daemon=True)

    def start(self) -> None:
        self._stdout_thread.start()
        self._stderr_thread.start()
        self._heartbeat_thread.start()
        initialized = self.request(
            "initialize",
            {
                "protocolVersion": 1,
                "clientInfo": {
                    "name": "codex-reasonix-go-bridge",
                    "title": "Codex Reasonix Go Bridge",
                    "version": "1",
                },
                "clientCapabilities": {
                    "fs": {"readTextFile": False, "writeTextFile": False},
                    "terminal": False,
                },
            },
            timeout=30,
        )
        capabilities = initialized.get("agentCapabilities", {})
        reasonix_meta = capabilities.get("_meta", {}).get("reasonix.io", {})
        advertised_steer = reasonix_meta.get("sessionSteer", {}).get("method")
        if isinstance(advertised_steer, str) and advertised_steer:
            self.steer_method = advertised_steer

        created = self.request(
            "session/new",
            {"cwd": str(self.cwd), "mcpServers": []},
            timeout=30,
        )
        session_id = created.get("sessionId")
        if not isinstance(session_id, str) or not session_id:
            raise AcpError("session/new did not return a sessionId")
        self.session_id = session_id
        self._configure(created.get("configOptions", []))
        self.emit(
            {
                "kind": "reasonix_acp_started",
                "session_id": session_id,
                "model": self.model,
                "steering": self.steer_method is not None,
            }
        )
        self._stdin_thread.start()

    def serve(self, initial_prompt: str, *, wall_seconds: int) -> int:
        prompt = initial_prompt
        while not self._shutdown.is_set():
            status = self.run_prompt(prompt, wall_seconds=wall_seconds)
            if status not in {0, 130}:
                return status
            if self._shutdown.is_set():
                break
            self.emit(
                {
                    "kind": "reasonix_idle",
                    "session_id": self.session_id,
                    "next": "send a message or /followup <message>; use /close to stop",
                }
            )
            while not self._shutdown.is_set():
                try:
                    prompt = self._followups.get(timeout=0.5)
                    break
                except queue.Empty:
                    continue
        return 0

    def run_prompt(self, prompt: str, *, wall_seconds: int) -> int:
        if self.session_id is None:
            raise AcpError("ACP session has not started")
        self._turn_number += 1
        self._message_parts.clear()
        self._cancelled.clear()
        self._turn_error_reason = None
        self._latest_status = {}
        self._last_activity_at = time.monotonic()
        self._prompt_active.set()
        self.emit(
            {
                "kind": "reasonix_prompt_started",
                "session_id": self.session_id,
                "turn": self._turn_number,
            }
        )
        try:
            result = self.request(
                "session/prompt",
                {
                    "sessionId": self.session_id,
                    "prompt": [{"type": "text", "text": prompt}],
                },
                timeout=wall_seconds,
            )
        except TimeoutError:
            self.cancel("wall timeout")
            self.emit({"kind": "reasonix_timeout", "wall_seconds": wall_seconds})
            return 124
        finally:
            self._prompt_active.clear()

        stop_reason = result.get("stopReason", "unknown")
        final_text = "".join(self._message_parts).strip()
        error_reason = self._turn_error_reason if stop_reason == "error" else None
        self.emit(
            {
                "kind": "reasonix_result",
                "session_id": self.session_id,
                "turn": self._turn_number,
                "stop_reason": stop_reason,
                "result": final_text,
                "error": error_reason,
            }
        )
        if self._cancelled.is_set() or stop_reason == "cancelled":
            return 130
        if stop_reason == "error":
            reason = error_reason or "Reasonix ended the turn without an error detail"
            if CAPACITY_PATTERN.search(reason):
                print("REASONIX_CAPACITY_UNAVAILABLE", file=sys.stderr, flush=True)
                return 75
            if PROVIDER_STREAM_PATTERN.search(reason):
                self.emit(
                    {
                        "kind": "reasonix_session_unhealthy",
                        "session_id": self.session_id,
                        "reason": self._bounded(reason),
                        "next": "close this worker and start a fresh ACP session",
                    }
                )
                print("REASONIX_PROVIDER_STREAM_FAILED", file=sys.stderr, flush=True)
                return 70
            print("REASONIX_TURN_FAILED", file=sys.stderr, flush=True)
            return 1
        return 0

    def request(self, method: str, params: dict[str, Any], *, timeout: float) -> dict[str, Any]:
        request_id = self._allocate_id()
        pending = PendingRequest(response=queue.Queue(maxsize=1))
        with self._pending_lock:
            self._pending[request_id] = pending
        self._send({"jsonrpc": "2.0", "id": request_id, "method": method, "params": params})
        try:
            message = pending.response.get(timeout=timeout)
        except queue.Empty as exc:
            with self._pending_lock:
                self._pending.pop(request_id, None)
            raise TimeoutError(f"ACP request timed out: {method}") from exc
        if "error" in message:
            error = message["error"]
            raise AcpError(f"{method} returned {error.get('code')}: {error.get('message')}")
        result = message.get("result")
        return result if isinstance(result, dict) else {}

    def notify(self, method: str, params: dict[str, Any]) -> None:
        self._send({"jsonrpc": "2.0", "method": method, "params": params})

    def steer(self, text: str) -> None:
        if not text:
            return
        if not self._prompt_active.is_set() or self.session_id is None:
            self.emit({"kind": "reasonix_steer_rejected", "reason": "no active prompt"})
            return
        if self.steer_method is None:
            self.emit({"kind": "reasonix_steer_rejected", "reason": "not advertised"})
            return
        try:
            self.request(
                self.steer_method,
                {
                    "sessionId": self.session_id,
                    "prompt": [{"type": "text", "text": text}],
                },
                timeout=15,
            )
        except (AcpError, TimeoutError) as exc:
            self.emit({"kind": "reasonix_steer_rejected", "reason": str(exc)})
            return
        self._message_parts.clear()
        self.emit({"kind": "reasonix_steer_accepted", "text": self._bounded(text)})

    def cancel(self, reason: str = "orchestrator request") -> None:
        if self.session_id is None or not self._prompt_active.is_set():
            self.emit({"kind": "reasonix_cancel_rejected", "reason": "no active prompt"})
            return
        self._cancelled.set()
        self.notify("session/cancel", {"sessionId": self.session_id})
        self.emit({"kind": "reasonix_cancel_requested", "reason": reason})

    def stop(self, reason: str = "orchestrator request") -> None:
        self._shutdown.set()
        if self._prompt_active.is_set():
            self.cancel(reason)
        self.emit({"kind": "reasonix_close_requested", "reason": reason})

    def followup(self, text: str) -> None:
        if not text:
            return
        self._followups.put(text)
        self.emit({"kind": "reasonix_followup_queued", "text": self._bounded(text)})

    def respond_permission(self, request_id: int, option_id: str) -> None:
        with self._permission_lock:
            request = self._permission_requests.pop(request_id, None)
        if request is None:
            self.emit(
                {"kind": "reasonix_permission_response_rejected", "request_id": request_id}
            )
            return
        option_ids = {
            option.get("optionId")
            for option in request.get("params", {}).get("options", [])
            if isinstance(option, dict)
        }
        if option_id not in option_ids:
            self.emit(
                {
                    "kind": "reasonix_permission_response_rejected",
                    "request_id": request_id,
                    "reason": "unknown option",
                }
            )
            with self._permission_lock:
                self._permission_requests[request_id] = request
            return
        self._send(
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "result": {"outcome": {"outcome": "selected", "optionId": option_id}},
            }
        )
        self.emit(
            {
                "kind": "reasonix_permission_responded",
                "request_id": request_id,
                "option_id": option_id,
            }
        )

    def close(self) -> None:
        if self._closed.is_set():
            return
        self._closed.set()
        if self.session_id is not None and self.process.poll() is None:
            try:
                self.request(
                    "session/close",
                    {"sessionId": self.session_id},
                    timeout=5,
                )
            except (AcpError, TimeoutError):
                pass
        if self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait(timeout=5)

    def capacity_unavailable(self) -> bool:
        return any(CAPACITY_PATTERN.search(line) for line in self._diagnostics)

    def emit(self, value: dict[str, Any]) -> None:
        with self._output_lock:
            print(json.dumps(value, ensure_ascii=False, separators=(",", ":")), flush=True)

    def _allocate_id(self) -> int:
        with self._write_lock:
            request_id = self._next_id
            self._next_id += 1
            return request_id

    def _send(self, value: dict[str, Any]) -> None:
        payload = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        with self._write_lock:
            if self.process.poll() is not None:
                raise AcpError("Reasonix ACP process is not running")
            self._peer_stdin.write(payload + "\n")
            self._peer_stdin.flush()

    def _configure(self, options: object) -> None:
        if not isinstance(options, list) or self.session_id is None:
            return
        desired = {
            "model": self.model,
            "effort": self.effort,
            "thought_level": self.effort,
            "work_mode": "balanced",
            "tool_approval": "auto",
        }
        for option in options:
            if not isinstance(option, dict):
                continue
            option_id = option.get("id")
            if not isinstance(option_id, str) or option_id not in desired:
                continue
            value = desired[option_id]
            available = option.get("options", [])
            if isinstance(available, list) and available:
                values = {
                    entry.get("value")
                    for entry in available
                    if isinstance(entry, dict)
                }
                if value not in values:
                    continue
            if option.get("currentValue") == value:
                continue
            self.request(
                "session/set_config_option",
                {"sessionId": self.session_id, "configId": option_id, "value": value},
                timeout=15,
            )

    def _read_stdout(self) -> None:
        for raw_line in self._peer_stdout:
            line = raw_line.strip()
            if not line:
                continue
            try:
                message = json.loads(line)
            except json.JSONDecodeError:
                self.emit({"kind": "reasonix_acp_protocol_warning", "text": self._bounded(line)})
                continue
            if not isinstance(message, dict):
                continue
            if "method" in message:
                if "id" in message:
                    self._handle_server_request(message)
                else:
                    self._handle_notification(message)
                continue
            response_id = message.get("id")
            if not isinstance(response_id, int):
                continue
            with self._pending_lock:
                pending = self._pending.pop(response_id, None)
            if pending is not None:
                pending.response.put(message)
        self._closed.set()

    def _read_stderr(self) -> None:
        for raw_line in self._peer_stderr:
            line = raw_line.strip()
            if not line:
                continue
            self._diagnostics.append(line)
            self.emit({"kind": "reasonix_diagnostic", "text": self._bounded(line)})

    def _handle_notification(self, message: dict[str, Any]) -> None:
        self._last_activity_at = time.monotonic()
        method = message.get("method")
        params = message.get("params", {})
        if method == "session/update" and isinstance(params, dict):
            update = params.get("update", {})
            if isinstance(update, dict):
                self._handle_session_update(update)
            return
        if method == "_reasonix.io/session/status_update" and isinstance(params, dict):
            status = params.get("status", {})
            if isinstance(status, dict):
                self._latest_status = status
                outcome = status.get("turnOutcome", status.get("turn_outcome", {}))
                if not isinstance(outcome, dict):
                    outcome = {}
                reason = outcome.get("reason")
                if isinstance(reason, str) and reason:
                    self._turn_error_reason = reason
                if params.get("event") == "completion":
                    self.emit(
                        {
                            "kind": "reasonix_usage",
                            "event": params.get("event"),
                            "usage": status.get("usage"),
                        }
                    )
                if outcome.get("kind") == "error" or status.get("phase") == "error":
                    self.emit(
                        {
                            "kind": "reasonix_error",
                            "session_id": self.session_id,
                            "reason": self._bounded(
                                self._turn_error_reason or "Reasonix reported an unspecified error"
                            ),
                        }
                    )

    def _handle_session_update(self, update: dict[str, Any]) -> None:
        self._last_activity_at = time.monotonic()
        update_kind = update.get("sessionUpdate")
        if update_kind == "agent_message_chunk":
            content = update.get("content", {})
            if isinstance(content, dict) and isinstance(content.get("text"), str):
                self._message_parts.append(content["text"])
            return
        if update_kind in {"agent_thought_chunk", "user_message_chunk"}:
            return
        if update_kind == "tool_call":
            self.emit(
                {
                    "kind": "reasonix_tool",
                    "id": update.get("toolCallId"),
                    "name": update.get("title"),
                    "tool_kind": update.get("kind"),
                    "status": update.get("status"),
                    "input": self._bounded_json(update.get("rawInput")),
                    "locations": update.get("locations"),
                }
            )
            return
        if update_kind == "tool_call_update":
            self.emit(
                {
                    "kind": "reasonix_tool_update",
                    "id": update.get("toolCallId"),
                    "status": update.get("status"),
                }
            )
            return
        if update_kind == "plan":
            self.emit({"kind": "reasonix_plan", "entries": update.get("entries")})

    def _handle_server_request(self, message: dict[str, Any]) -> None:
        request_id = message.get("id")
        method = message.get("method")
        if not isinstance(request_id, int):
            return
        if method != "session/request_permission":
            self._send(
                {
                    "jsonrpc": "2.0",
                    "id": request_id,
                    "error": {"code": -32601, "message": f"unsupported request: {method}"},
                }
            )
            return
        params = message.get("params", {})
        if not isinstance(params, dict):
            params = {}
        options = params.get("options", [])
        tool_call = params.get("toolCall", {})
        raw_input = tool_call.get("rawInput", {}) if isinstance(tool_call, dict) else {}
        is_question = isinstance(raw_input, dict) and (
            "question" in raw_input or "options" in raw_input
        )
        if not is_question and isinstance(options, list):
            allow_once = next(
                (
                    option
                    for option in options
                    if isinstance(option, dict) and option.get("kind") == "allow_once"
                ),
                None,
            )
            if allow_once is not None:
                self._send(
                    {
                        "jsonrpc": "2.0",
                        "id": request_id,
                        "result": {
                            "outcome": {
                                "outcome": "selected",
                                "optionId": allow_once.get("optionId"),
                            }
                        },
                    }
                )
                self.emit(
                    {
                        "kind": "reasonix_permission_auto_allowed",
                        "request_id": request_id,
                        "tool": tool_call.get("title") if isinstance(tool_call, dict) else None,
                    }
                )
                return
        with self._permission_lock:
            self._permission_requests[request_id] = message
        self.emit(
            {
                "kind": "reasonix_permission_request",
                "request_id": request_id,
                "tool": tool_call,
                "options": options,
                "respond_with": f"/respond {request_id} <option-id>",
            }
        )

    def _heartbeat(self) -> None:
        while not self._closed.wait(self.heartbeat_seconds):
            self.emit(
                {
                    "kind": "reasonix_running",
                    "session_id": self.session_id,
                    "prompt_active": self._prompt_active.is_set(),
                    "elapsed_seconds": int(time.monotonic() - self._started_at),
                    "activity_idle_seconds": int(
                        time.monotonic() - self._last_activity_at
                    ),
                    "meaning": "bridge liveness only; not proof of model progress",
                }
            )

    def _read_orchestrator_input(self) -> None:
        for raw_line in sys.stdin:
            line = raw_line.strip()
            if not line:
                continue
            if line == "/cancel":
                self.cancel()
                continue
            if line == "/close":
                self.stop()
                continue
            if line.startswith("/followup "):
                self.followup(line.removeprefix("/followup ").strip())
                continue
            if line.startswith("/respond "):
                parts = line.split(maxsplit=2)
                if len(parts) != 3 or not parts[1].isdigit():
                    self.emit(
                        {
                            "kind": "reasonix_input_error",
                            "usage": "/respond <request-id> <option-id>",
                        }
                    )
                    continue
                self.respond_permission(int(parts[1]), parts[2])
                continue
            if line.startswith("/steer "):
                self.steer(line.removeprefix("/steer ").strip())
            elif self._prompt_active.is_set():
                self.steer(line)
            else:
                self.followup(line)

    @staticmethod
    def _bounded(value: str) -> str:
        return value if len(value) <= MAX_EVENT_TEXT else value[:MAX_EVENT_TEXT] + "..."

    def _bounded_json(self, value: object) -> object:
        if value is None:
            return None
        encoded = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        if len(encoded) <= MAX_EVENT_TEXT:
            return value
        return encoded[:MAX_EVENT_TEXT] + "..."


def positive_integer(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--reasonix-bin", required=True)
    parser.add_argument("--dir", type=Path, required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--effort", default="high")
    parser.add_argument("--wall-seconds", type=positive_integer, default=1_800)
    parser.add_argument("--heartbeat-seconds", type=positive_integer, default=20)
    parser.add_argument("task")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    bridge = AcpBridge(
        binary=args.reasonix_bin,
        cwd=args.dir.resolve(),
        model=args.model,
        effort=args.effort,
        heartbeat_seconds=args.heartbeat_seconds,
    )

    def request_cancel(_signum: int, _frame: object) -> None:
        bridge.stop("signal")

    signal.signal(signal.SIGTERM, request_cancel)
    signal.signal(signal.SIGINT, request_cancel)
    try:
        bridge.start()
        return bridge.serve(args.task, wall_seconds=args.wall_seconds)
    except (AcpError, TimeoutError, OSError) as exc:
        message = str(exc)
        bridge.emit({"kind": "reasonix_acp_failed", "error": message})
        if CAPACITY_PATTERN.search(message) or bridge.capacity_unavailable():
            print("REASONIX_CAPACITY_UNAVAILABLE", file=sys.stderr, flush=True)
            return 75
        return 1
    finally:
        bridge.close()


if __name__ == "__main__":
    raise SystemExit(main())
