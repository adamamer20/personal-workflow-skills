#!/usr/bin/env bash
set -euo pipefail

mode="${1:-review}"
if (( $# > 0 )); then
  shift
fi

if (( $# > 0 )); then
  prompt="$*"
else
  prompt="$(</dev/stdin)"
fi

if [[ -z "${prompt//[[:space:]]/}" ]]; then
  printf 'Usage: reasonix-go-worker review|explore|implement|interactive <task>\n' >&2
  exit 64
fi

reasonix_bin="${REASONIX_BIN:-}"
if [[ -z "$reasonix_bin" ]]; then
  reasonix_bin="$(command -v reasonix || true)"
fi
if [[ -z "$reasonix_bin" && -x "${HOME}/.local/bin/reasonix" ]]; then
  reasonix_bin="${HOME}/.local/bin/reasonix"
fi
if [[ -z "$reasonix_bin" || ! -x "$reasonix_bin" ]]; then
  printf 'Reasonix is not installed or executable.\n' >&2
  exit 69
fi

model="${REASONIX_GO_MODEL:-opencode-go/deepseek-v4-flash}"
effort="${REASONIX_GO_EFFORT:-high}"

case "$mode" in
  review|explore)
    steps="${REASONIX_MAX_STEPS:-0}"
    wall_seconds="${REASONIX_WALL_SECONDS:-900}"
    command=(
      "$reasonix_bin" subagent try "$mode"
      --model "$model"
      --max-steps "$steps"
      --dir "$PWD"
      "$prompt"
    )
    ;;
  implement)
    steps="${REASONIX_MAX_STEPS:-0}"
    wall_seconds="${REASONIX_WALL_SECONDS:-1800}"
    command=(
      "$reasonix_bin" run --auto
      --model "$model"
      --effort "$effort"
      --max-steps "$steps"
      --dir "$PWD"
      --output-format stream-json
      "$prompt"
    )
    ;;
  interactive)
    wall_seconds="${REASONIX_WALL_SECONDS:-1800}"
    heartbeat_seconds="${REASONIX_HEARTBEAT_SECONDS:-20}"
    script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    exec "$script_dir/reasonix-go-acp-worker" \
      --reasonix-bin "$reasonix_bin" \
      --dir "$PWD" \
      --model "$model" \
      --effort "$effort" \
      --wall-seconds "$wall_seconds" \
      --heartbeat-seconds "$heartbeat_seconds" \
      "$prompt"
    ;;
  *)
    printf 'Unknown mode: %s\nValid modes: review, explore, implement, interactive\n' "$mode" >&2
    exit 64
    ;;
esac

if [[ ! "$steps" =~ ^[0-9]+$ ]]; then
  printf 'REASONIX_MAX_STEPS must be zero or a positive integer.\n' >&2
  exit 64
fi

heartbeat_seconds="${REASONIX_HEARTBEAT_SECONDS:-20}"
if [[ ! "$heartbeat_seconds" =~ ^[1-9][0-9]*$ ]]; then
  printf 'REASONIX_HEARTBEAT_SECONDS must be a positive integer.\n' >&2
  exit 64
fi

run_dir="$(mktemp -d)"
stdout_log="$run_dir/stdout.log"
stderr_log="$run_dir/stderr.log"
stdout_pipe="$run_dir/stdout.pipe"
stderr_pipe="$run_dir/stderr.pipe"
mkfifo "$stdout_pipe" "$stderr_pipe"

cleanup() {
  rm -f "$stdout_pipe" "$stderr_pipe" "$stdout_log" "$stderr_log"
  rmdir "$run_dir" 2>/dev/null || true
}
trap cleanup EXIT

if [[ "$mode" == "implement" ]] && command -v jq >/dev/null 2>&1; then
  tee "$stdout_log" <"$stdout_pipe" | jq -Rrc --unbuffered '
    . as $line
    | (try fromjson catch {kind: "diagnostic", text: $line})
    | if .kind == "turn_started" then
        {kind: "reasonix_turn_started"}
      elif .kind == "tool_dispatch" and .tool.args? != null then
        {kind: "reasonix_tool", name: .tool.name,
         args: (if (.tool.args | length) > 1200 then
                  (.tool.args[:1200] + "...")
                else .tool.args end),
         read_only: .tool.readOnly}
      elif .kind == "tool_result" then
        {kind: "reasonix_tool_result", name: .tool.name,
         error: (.tool.error // null)}
      elif .kind == "message" and (.text? // "") != "" then
        {kind: "reasonix_message", text: .text}
      elif .type == "result" then
        {kind: "reasonix_result", ok: (.is_error | not),
         subtype: .subtype, result: .result,
         duration_ms: .duration_ms, usage: .usage}
      elif .kind == "diagnostic" then .
      else empty end
  ' &
else
  tee "$stdout_log" <"$stdout_pipe" &
fi
stdout_reader_pid=$!
tee "$stderr_log" <"$stderr_pipe" >&2 &
stderr_reader_pid=$!

printf 'REASONIX_STARTED mode=%s model=%s max_steps=%s wall_seconds=%s\n' \
  "$mode" "$model" "$steps" "$wall_seconds"

timeout --signal=TERM --kill-after=10s "$wall_seconds" \
  "${command[@]}" >"$stdout_pipe" 2>"$stderr_pipe" &
command_pid=$!
started_at=$SECONDS

(
  while kill -0 "$command_pid" 2>/dev/null; do
    sleep "$heartbeat_seconds"
    if kill -0 "$command_pid" 2>/dev/null; then
      printf 'REASONIX_RUNNING mode=%s elapsed_seconds=%s\n' \
        "$mode" "$((SECONDS - started_at))"
    fi
  done
) &
monitor_pid=$!

set +e
wait "$command_pid"
status=$?
set -e

kill "$monitor_pid" 2>/dev/null || true
wait "$monitor_pid" 2>/dev/null || true
wait "$stdout_reader_pid" 2>/dev/null || true
wait "$stderr_reader_pid" 2>/dev/null || true

structured_error=""
if [[ "$mode" == "implement" ]] && command -v jq >/dev/null 2>&1; then
  structured_error="$(
    jq -Rr 'fromjson? | select(.type == "result" and .is_error == true) | .result // empty' \
      "$stdout_log" | tail -n 1
  )"
fi
diagnostic_error="$(<"$stderr_log")"
error_evidence="$structured_error"$'\n'"$diagnostic_error"

if (( status == 124 )); then
  printf 'REASONIX_TIMEOUT wall_seconds=%s\n' "$wall_seconds" >&2
  exit 124
fi

if (( status != 0 )) || [[ -n "$structured_error" ]]; then
  if grep -Eiq 'tool[- ]call limit|maximum tool calls|max(imum)? steps?|step limit|round budget' \
      <<<"$error_evidence"; then
    printf 'REASONIX_BUDGET_EXHAUSTED\n' >&2
    exit 76
  fi
  if grep -Eiq 'usage limit|rate limit|quota|insufficient (balance|credit)|subscription.*limit|too many requests|http[^0-9]*429' \
      <<<"$error_evidence"; then
    printf 'REASONIX_CAPACITY_UNAVAILABLE\n' >&2
    exit 75
  fi
  printf 'REASONIX_WORKER_FAILED status=%s\n' "$status" >&2
  exit "$status"
fi
