{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-workflow-skills.invalid/schemas/capsule.schema.json",
  "title": "Controller-facing model capsule",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "objective",
        "decomposition",
        "acceptance_criteria",
        "surfaces",
        "acceptance",
        "prompt",
        "recovery_policy"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "objective": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)"},
        "decomposition": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)"}
        },
        "acceptance_criteria": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
