        },
        "surfaces": {
          "type": "object", "minProperties": 0, "maxProperties": 128,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)"},
          "additionalProperties": {"type": "string", "enum": ["mutable", "protected"]}
        },
        "acceptance": {
          "type": "object", "minProperties": 1, "maxProperties": 3, "additionalProperties": false,
          "properties": {
            "objective": {"type": "string", "const": "code-reviewer"},
            "visual": {"type": "string", "const": "visual-reviewer"},
            "architecture": {"type": "string", "const": "architecture-reviewer"}
          }
        },
        "prompt": {"type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)"},
        "recovery_policy": {"type": "string", "const": "completion_biased"}
      }
    },
