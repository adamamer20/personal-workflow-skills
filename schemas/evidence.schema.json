{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-workflow-skills.invalid/schemas/evidence.schema.json",
  "title": "Bounded evidence pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question", "conclusion", "claims"],
  "properties": {
    "schema_version": {"enum": [1, "1"]},
    "question": {"type": "string", "minLength": 1},
    "conclusion": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence", "inference", "confidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "inference": {"type": "boolean"}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "uncertainty": {"type": "string"}}}},
    "artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
