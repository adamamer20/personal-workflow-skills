{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-workflow-skills.invalid/schemas/review.schema.json",
  "title": "Independent workflow review",
  "description": "One review invocation evaluates one fixed point through exactly one explicit lens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "milestone", "fixed_point", "lens", "verdict", "findings", "evidence_inspected"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "milestone": {"type": "string", "minLength": 1},
    "fixed_point": {"type": "string", "minLength": 1},
    "lens": {"type": "string", "enum": ["spec", "correctness", "standards", "contract-risk", "security", "visual"]},
    "verdict": {"type": "string", "enum": ["accepted", "accepted_with_deferred", "repair_required", "replan_recommended", "needs_decision", "external_blocked", "invalid_review_input"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "evidence_inspected": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "deferred_findings": {"type": "array", "items": {"type": "string", "pattern": "^F-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "promotion_blocking_findings": {"type": "array", "items": {"type": "string", "pattern": "^F-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
    "guarantee_challenges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["guarantee", "required_outcome", "named_failure_or_threat", "documented_boundary", "simpler_sufficient_guarantee"], "properties": {"guarantee": {"type": "string", "minLength": 1}, "required_outcome": {"type": "string", "minLength": 1}, "named_failure_or_threat": {"type": "string", "minLength": 1}, "documented_boundary": {"type": "string", "minLength": 1}, "simpler_sufficient_guarantee": {"type": "string", "minLength": 1}, "user_or_plan_decision_needed": {"type": "boolean"}}}},
    "required_next_action": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lens", "severity", "promotion_blocking", "promotion_reason", "acceptance_or_guarantee", "location_or_artifact", "evidence", "causal_class", "user_impact_or_dependency_risk", "required_action"],
      "properties": {
        "schema_version": {"enum": [1, "1"]},
        "id": {"type": "string", "pattern": "^F-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "lens": {"type": "string", "enum": ["spec", "correctness", "standards", "contract-risk", "security", "visual"]},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "promotion_blocking": {"type": "boolean"},
        "promotion_reason": {"type": "string", "minLength": 1},
        "acceptance_or_guarantee": {"type": "string", "minLength": 1},
        "location_or_artifact": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["source", "detail"], "properties": {"source": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}, "kind": {"type": "string", "enum": ["observation", "command", "artifact", "test"]}}}]}},
        "causal_class": {"type": "string", "minLength": 1},
        "user_impact_or_dependency_risk": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "defer_to": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"promotion_blocking": {"const": false}}}, "then": {"required": ["defer_to"]}}]
    }
  }
}
